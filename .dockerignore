# Files/dirs that should NOT be sent to the Docker build context
# (keeps the context small and prevents secrets/large files from leaking in)

# Python virtual environment (hundreds of MB)
.venv/

# Compiled bytecode
__pycache__/
*.pyc
*.pyo
*.pyd

# Pipeline outputs (large WAV / PDF files — bind-mounted at runtime)
output/

# Input audio files (bind-mounted at runtime via ./input volume)
*.mp3
*.wav
*.flac
*.ogg

# Git history
.git/
.gitignore
.gitattributes

# Editor / OS artefacts
.vscode/
.idea/
*.DS_Store
Thumbs.db

# Docs (not needed inside the image)
README.md

# Other compose overrides or local config
docker-compose.override.yml
.env
